# Server Port
PORT=5000

# Frontend URL (CORS origin)
FRONTEND_URL=http://localhost:5173

# SMTP Server Configurations (e.g. Gmail SMTP, Resend, SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username@gmail.com
SMTP_PASS=your_smtp_app_password

# Target Email to receive contact form notifications
